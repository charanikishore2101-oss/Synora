          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"sreecharani\",\n  \"password\": \"wrongpassword\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login/",
          "host": ["{{base_url}}"],
          "path": ["login", ""]
        },
        "description": "Attempts to login with wrong password. bcrypt.compare fails. Returns 400 Bad Request with 'Invalid password'."
      }
    },
    {
      "name": "9. Login Missing Credentials (POST /login/)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
