{
  "info": {
    "_postman_id": "lab-04-auth-jwt-collection",
    "name": "Lab 04 - Registration, Login and JWT Authentication",
    "description": "Postman API Collection for Backend Development Fundamentals Lab 04 by Sree Charani (Reg: 252U1R3059). Covers user registration, duplicate user rejection, input validations, login with bcrypt password matching, and JWT token generation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Successful Registration (POST /register/)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"sreecharani\",\n  \"name\": \"Sree Charani\",\n  \"password\": \"mypassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/register/",
          "host": ["{{base_url}}"],
          "path": ["register", ""]
        },
        "description": "Registers a new user account with bcrypt password hashing. Returns 201 Created."
      }
    },
    {
      "name": "2. Duplicate Username Rejection (POST /register/)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"sreecharani\",\n  \"name\": \"Sree Charani\",\n  \"password\": \"mypassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/register/",
          "host": ["{{base_url}}"],
          "path": ["register", ""]
        },
        "description": "Attempts to register the same username again. Returns 400 Bad Request with 'User already exists'."
      }
    },
    {
      "name": "3. Registration Missing Username (POST /register/)",
      "request": {
        "method": "POST",
        "header": [
          {
