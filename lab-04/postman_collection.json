          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sree Charani\",\n  \"password\": \"mypassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/register/",
          "host": ["{{base_url}}"],
          "path": ["register", ""]
        },
        "description": "Validation test for missing username. Returns 400 Bad Request."
      }
    },
    {
      "name": "4. Registration Missing Name (POST /register/)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"sreecharani\",\n  \"password\": \"mypassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/register/",
          "host": ["{{base_url}}"],
          "path": ["register", ""]
        },
        "description": "Validation test for missing name. Returns 400 Bad Request."
      }
    },
    {
      "name": "5. Registration Missing Password (POST /register/)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"sreecharani\",\n  \"name\": \"Sree Charani\"\n}"
