          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"sreecharani\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login/",
          "host": ["{{base_url}}"],
          "path": ["login", ""]
        },
        "description": "Validation test for missing password in login. Returns 400 Bad Request."
      }
    },
    {
      "name": "10. Inspect Database Users (GET /users)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/users",
          "host": ["{{base_url}}"],
          "path": ["users"]
        },
        "description": "Inspects SQLite user table to verify passwords are stored as bcrypt hashes ($2b$10$...)."
