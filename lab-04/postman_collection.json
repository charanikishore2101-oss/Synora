      }
    },
    {
      "name": "6. Successful Login (POST /login/)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"sreecharani\",\n  \"password\": \"mypassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login/",
          "host": ["{{base_url}}"],
          "path": ["login", ""]
        },
        "description": "Authenticates valid credentials against bcrypt hash and returns a signed JWT token. Returns 200 OK."
      }
    },
    {
      "name": "7. Login Unknown Username (POST /login/)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"unknownuser\",\n  \"password\": \"mypassword123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login/",
          "host": ["{{base_url}}"],
          "path": ["login", ""]
        },
        "description": "Attempts to login with a non-existent username. Returns 400 Bad Request with 'Invalid user'."
      }
    },
    {
      "name": "8. Login Incorrect Password (POST /login/)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
